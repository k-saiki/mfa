{
  "$schema": 'https://docs.renovatebot.com/renovate-schema.json',
  configMigration: true,
  extends: [
    'config:best-practices',
    'github>aquaproj/aqua-renovate-config#2.13.0',
  ],
  packageRules: [
    {
      matchPackageNames: [
        'aquaproj/aqua-registry',
      ],
      extends: [
        'schedule:monthly',
      ]
    }
  ]
}
